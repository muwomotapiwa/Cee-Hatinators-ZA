# Supabase browser client settings.
# These values are safe to expose in Vite, but database passwords and direct
# Postgres connection strings must never go in frontend env files.
VITE_SUPABASE_URL="https://replace-me.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"

# Live site URL used by Supabase email verification and OAuth redirects.
# Set this in Cloudflare Pages to the real public URL, not localhost.
VITE_AUTH_REDIRECT_URL="https://your-live-domain.example/Cee-Hatinators-ZA/"

# Payment provider selection is handled server-side. Yoco secret keys must be
# set as Supabase Edge Function secrets, never as Vite/frontend variables:
#   YOCO_SECRET_KEY
#   YOCO_WEBHOOK_SECRET
#   SITE_URL
